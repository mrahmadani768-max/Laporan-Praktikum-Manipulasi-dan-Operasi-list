# NO.1

kendaraan = ["motor", "mobil", "sepeda", "bus"]

# a. Menambahkan truk di akhir list 
kendaraan.append("truk")

# b. Menyisipkan becak pada index ke-1 
kendaraan.insert(1, "becak")

# c. Menghapus data paling belakang 
kendaraan.pop()

# d. Mengubah sepeda menjadi skuter
kendaraan[3] = "skuter"

# e. Menampilkan jumlah seluruh data
print("Data kendaraan:", kendaraan)
print("Jumlah kendaraan:", len(kendaraan))

# NO.2

angka = [75, 80, 90, 75, 85, 100, 65]

# a. Mencari index nilai 100
print("Index nilai 100:", angka.index(100))

# b. Menghitung jumlah nilai 75
print("Jumlah nilai 75:", angka.count(75))

# c. Mengurutkan nilai dari terkecil ke terbesar
angka.sort()
print("urutan dari yang terkecil:", angka)

# d. Membalikkan urutan list
angka.reverse()
print("Urutan dari yang terbesar:", angka)

